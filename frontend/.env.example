# ============================================================
# HESABIKA TRUST — Frontend Environment Variables
# Copy this file to .env and fill in your values
# These are PUBLIC/publishable keys — safe for browser use
# NEVER put secret keys here
# ============================================================

# Supabase (publishable/public key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# API URL — leave empty on Vercel (uses same domain)
# Set to http://localhost:3000 for local development with Vercel CLI
VITE_API_URL=

# App name
VITE_APP_NAME=Hesabika Trust